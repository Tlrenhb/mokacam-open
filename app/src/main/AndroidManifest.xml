<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Original permission set (pruned to what the ported code uses) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Wi-Fi SSID detection requires location permission on API 29+ -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <application
        android:name="com.aee.mokacam.AeeApplication"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:name="com.aee.mokacam.activity.ComposeMainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.aee.mokacam.activity.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.aee.mokacam.activity.ProductActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.aee.mokacam.activity.ProductParamsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.aee.mokacam.activity.DownLoadActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.aee.mokacam.activity.LegalActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.aee.mokacam.activity.SupportActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.aee.mokacam.activity.RegisterActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.aee.mokacam.activity.WifiPswChangeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.aee.mokacam.activity.ProductInSupportActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.aee.mokacam.activity.DroneInSupportActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.aee.mokacam.activity.AeeAppSettingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.aee.mokacam.activity.ComposeLibraryActivity"
            android:exported="false"
            android:screenOrientation="fullSensor" />

        <activity
            android:name="com.aee.mokacam.activity.ComposeSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.aee.mokacam.activity.ComposeInfoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.aee.mokacam.activity.SelectLibraryActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:screenOrientation="fullSensor" />

        <activity
            android:name="com.aee.mokacam.activity.SelectSimpleActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.aee.mokacam.activity.ShowPicOrVideoActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:screenOrientation="fullSensor" />

        <activity
            android:name="com.aee.mokacam.activity.LibraryActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:screenOrientation="fullSensor" />

        <activity
            android:name="com.aee.mokacam.activity.ComposeCameraActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.FullscreenBridge" />

        <activity
            android:name="com.aee.mokacam.activity.AeeCameraActivty"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.FullscreenBridge" />

        <activity
            android:name="com.aee.mokacam.activity.AeeCameraSettingActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.TranslucentBridge" />

        <activity
            android:name="com.aee.mokacam.activity.AeeCameraPlaybackActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false" />

        <activity
            android:name="com.aee.mokacam.activity.AeeCameraWifiConfigActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
