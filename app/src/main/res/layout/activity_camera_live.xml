<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.media3.ui.PlayerView
        android:id="@+id/rtsp_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/iv_cam_cack"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@string/cancel"
                android:src="@drawable/ic_arrow_back" />

            <ImageView
                android:id="@+id/iv_cam_home"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="16dp"
                android:contentDescription="@string/connect"
                android:src="@drawable/ic_menu" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_video_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <View
                android:id="@+id/record_point"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_record_h"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/iv_camera_setting"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="16dp"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_menu" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:id="@+id/iv_video_mode"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/video_setting"
                android:src="@drawable/btn_record_n" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/iv_operate"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/photo"
                android:src="@drawable/btn_video_mode" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/iv_photo_mode"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/photo"
                android:src="@drawable/ic_photo_placeholder" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/photo_mode_window"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_signal_shot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/photo"
            android:textColor="@color/text_dark" />

        <TextView
            android:id="@+id/tv_brust_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/burst"
            android:textColor="@color/text_dark" />

        <TextView
            android:id="@+id/tv_delay_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/delay_photo"
            android:textColor="@color/text_dark" />
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_libary"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="20dp"
        android:contentDescription="@string/library_title"
        android:src="@drawable/ic_photo_placeholder" />
</FrameLayout>
