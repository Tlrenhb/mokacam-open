<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:background="#ffffffff" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout android:id="@+id/fl_video" android:visibility="visible" android:layout_width="fill_parent" android:layout_height="fill_parent">
        <FrameLayout android:layout_gravity="center" android:id="@+id/video_frame" android:background="#ff000000" android:layout_width="fill_parent" android:layout_height="fill_parent">
            <SurfaceView android:layout_gravity="center" android:id="@+id/surfaceview_video" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ProgressBar android:layout_gravity="center" android:id="@+id/video_loading_pb" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="wrap_content" android:indeterminateDuration="1200" style="@style/mProgress_circle" />
        </FrameLayout>
    </FrameLayout>
    <FrameLayout android:id="@+id/fl_image" android:background="#ff000000" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="fill_parent">
        <com.aee.mokacam.widget.PinchImageView android:layout_gravity="center" android:id="@+id/pv_show" android:layout_width="fill_parent" android:layout_height="wrap_content" />
    </FrameLayout>
</FrameLayout>
