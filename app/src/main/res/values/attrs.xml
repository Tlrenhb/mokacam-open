<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="RatioLayout">
        <attr name="picRatio" format="float" />
        <attr name="relative">
            <enum name="height" value="1" />
            <enum name="width" value="0" />
        </attr>
    </declare-styleable>
    <declare-styleable name="SettingsItemViewWithArrow">
        <attr name="leftText" format="string" />
        <attr name="rightText" format="string" />
    </declare-styleable>
    <declare-styleable name="SettingsItemViewWithToggle">
        <attr name="item_leftText" format="string" />
    </declare-styleable>
    <declare-styleable name="ToggleButton">
        <attr name="borderWidth" format="dimension" />
        <attr name="offBorderColor" format="reference|color" />
        <attr name="offColor" format="reference|color" />
        <attr name="onColor" format="reference|color" />
        <attr name="spotColor" format="reference|color" />
        <attr name="animate" format="reference|boolean" />
        <attr name="isDefaultOn" format="reference|boolean" />
    </declare-styleable>
</resources>
