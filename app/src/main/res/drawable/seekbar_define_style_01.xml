<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="10.0dip" />
            <gradient android:startColor="#ff8d8d8d" android:endColor="#ff8d8d8d" android:angle="270.0" android:centerY="0.75" android:centerColor="#ff8d8d8d" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="10.0dip" />
                <gradient android:startColor="#ffffce55" android:endColor="#ffffce55" android:angle="0.0" />
            </shape>
        </clip>
    </item>
</layer-list>
